{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "force-config",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  // Branded App Store / marketing host. API also remains on *.workers.dev so
  // already-shipped app builds keep working.
  "routes": [
    { "pattern": "forcemagic.app", "custom_domain": true },
    { "pattern": "www.forcemagic.app", "custom_domain": true }
  ],
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Sweep peek rows past the ten-minute lifetime so expired entries leave D1 even
  // when nobody writes to that id again.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Caps unauthenticated peek writes per performer id. Fingers stay under this;
  // a script burning entry ids does not.
  "ratelimits": [
    {
      "name": "PEEK_WRITE_LIMIT",
      "namespace_id": "9001",
      "simple": {
        "limit": 100,
        "period": 10
      }
    },
    // Caps config writes per client IP so one machine cannot claim ids in bulk. An
    // install publishes once per settings change, so thirty a minute is generous.
    {
      "name": "CONFIG_WRITE_LIMIT",
      "namespace_id": "9002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  // D1 rather than KV: KV reads can serve up to 60s stale from edge cache, and a
  // stale force number mid-performance would silently break the trick.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "force-config",
      "database_id": "4c60be38-8464-4f27-b39c-65e7c605f3e2",
      "migrations_dir": "./migrations"
    }
  ]
}
