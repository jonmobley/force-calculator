{
  "name": "force-config-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Serves Force calculator settings to the App Clip so written NFC tags and QR codes never go stale.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "migrate": "wrangler d1 migrations apply force-config --remote",
    "migrate:local": "wrangler d1 migrations apply force-config --local",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.42.0"
  }
}
